.installed.cfg
*.egg

# 6. Arquivos compactados e Dumps
*.zip
*.tar.gz
*.tgz
*.rar
*.bak
*.swp
*.swo
*.tmp
*.DS_Store
Thumbs.db

# 7. IDEs e Editores
